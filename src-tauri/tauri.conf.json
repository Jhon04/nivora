{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Nivora",
  "version": "1.0.6",
  "identifier": "pe.pluton.nivora",
  "build": {
    "frontendDist": "../dist/nivora/browser",
    "devUrl": "http://localhost:4200",
    "beforeDevCommand": "npm start",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Nivora",
        "width": 1100,
        "height": 720,
        "minWidth": 720,
        "minHeight": 500,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**", "$APPLOCALDATA/**"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdFQjA2NzlBOUY3ODU4M0MKUldROFdIaWZtbWV3Zmh6RmpnUHZiblV4N0wzbk1QQ1ZhWlFGQXJZc1QxTjd6aExHWFc4cUpMOVkK",
      "endpoints": [
        "https://github.com/Jhon04/nivora/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "category": "Productivity",
    "publisher": "Jhon04",
    "homepage": "https://github.com/Jhon04/nivora",
    "shortDescription": "Editor de notas local",
    "longDescription": "Notas locales en ficheros propios, con bóvedas independientes, búsqueda, bloques cifrados y sincronización opcional por GitHub. Sin servidor ni cuenta obligatoria.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
